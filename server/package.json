{
  "name": "pure-insights-server",
  "version": "1.0.0",
  "description": "Pure Insights Command Center - backend API, ingestion pipeline, alert engine and WebSocket hub",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"tests/**/*.test.js\"",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/seedUsers.js",
    "data-quality": "node scripts/dataQualityReport.js",
    "test:coverage": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-reporter=spec \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
