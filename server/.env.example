# Copy to server/.env and adjust. Every value has a safe development default,
# so the app runs without a .env file. In production (NODE_ENV=production)
# JWT_SECRET and INGEST_API_KEY are REQUIRED and demo users are not seeded.

NODE_ENV=development
PORT=3000
# debug | info | warn | error | silent
LOG_LEVEL=info

# Storage (SQLite file, created automatically)
DATABASE_PATH=./data/pure-insights.db

# Security
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# The feeder sends this in the x-api-key header
INGEST_API_KEY=dev-ingest-key
SEED_DEMO_USERS=true
# Login attempts allowed per IP per 15 minutes
LOGIN_RATE_LIMIT=20
# Extra browser origins allowed to open the WebSocket (comma separated; the server's own origin is always allowed)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Alert rules (Task 2)
# Alert when avg load time is strictly greater than this
LATENCY_THRESHOLD_SEC=15
# Above this the latency alert is critical
LATENCY_CRITICAL_SEC=30
# A re-breach within this window reopens the last alert instead of creating a new one
ALERT_COOLDOWN_SEC=300

# Cost model assumptions
CREDIT_PRICE_USD=3.0
COST_OUTLIER_MULTIPLIER=3
# Tukey fence width for cost vs usage mismatches (1.5 = standard box-plot rule, 3 = only extreme outliers)
COST_MISMATCH_IQR_K=1.5
